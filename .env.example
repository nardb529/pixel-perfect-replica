# CampusLoop Public Configuration (Browser-Safe Variables Only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SITE_URL=https://pixel-perfect-replica-five-psi.vercel.app

# Web Push (Public VAPID key goes in browser; Private VAPID key stays in Supabase Secrets)
VITE_VAPID_PUBLIC_KEY=

# Paystack Public Key (Optional browser reference; billing launches 1st Dec 2026)
VITE_PAYSTACK_PUBLIC_KEY=

# Edge Function / Supabase CLI Secrets Only (NEVER expose in VITE_* browser variables)
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@campusloop.app
# PAYSTACK_SECRET_KEY=
# ALLOWED_ORIGIN=https://pixel-perfect-replica-five-psi.vercel.app
